---
interface Props {
	href: string;
	variante?: 'primario' | 'claro';
	// Pide inicio de sesión (Google) antes de navegar al destino.
	requiereSesion?: boolean;
}

const { href, variante = 'primario', requiereSesion = false } = Astro.props;

// Cada variante trae sus propios colores de foco y de modo oscuro, porque ninguno sirve en ambos modos.
const variantes = {
	primario:
		'bg-brand-700 text-white shadow-sm hover:bg-brand-800 focus-visible:outline-brand-600 dark:bg-brand-400 dark:text-brand-950 dark:hover:bg-brand-300 dark:focus-visible:outline-brand-300',
	claro: 'bg-white text-brand-900 shadow-sm hover:bg-brand-50 focus-visible:outline-white',
};
---

<a
	href={href}
	data-requiere-sesion={requiereSesion ? '' : undefined}
	class:list={[
		'inline-flex w-full items-center justify-center rounded-md px-6 py-3 text-base font-semibold transition sm:w-auto',
		'focus-visible:outline-2 focus-visible:outline-offset-2',
		variantes[variante],
	]}
>
	<slot />
</a>
