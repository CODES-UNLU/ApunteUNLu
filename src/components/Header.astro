---
const enlaces = [
	{ texto: 'Material', href: '/material', clase: '', requiereSesion: true },
	{ texto: 'Cómo funciona', href: '/#como-funciona', clase: 'hidden sm:block' },
];
---

<header
	class="sticky top-0 z-20 border-b border-neutral-200 bg-white/85 backdrop-blur dark:border-neutral-800 dark:bg-neutral-950/85"
>
	<div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4 sm:px-6 lg:px-8">
		<a
			href="/"
			class="rounded font-display text-xl font-semibold tracking-tight text-brand-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-600 dark:text-brand-100 dark:focus-visible:outline-accent-300"
		>
			ApunteUNLu<span class="text-accent-500" aria-hidden="true">.</span>
		</a>

		<nav aria-label="Principal">
			<ul class="flex items-center gap-6 text-sm font-medium">
				{
					enlaces.map((enlace) => (
						<li class={enlace.clase}>
							<a
								href={enlace.href}
								data-requiere-sesion={enlace.requiereSesion ? '' : undefined}
								class="rounded text-neutral-700 underline decoration-transparent underline-offset-4 transition hover:text-brand-700 hover:decoration-accent-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-600 dark:text-neutral-300 dark:hover:text-white dark:focus-visible:outline-accent-300"
							>
								{enlace.texto}
							</a>
						</li>
					))
				}
			</ul>
		</nav>
	</div>
</header>
