---
const enlaces = [
	{ texto: 'Material', href: '/material', clase: '', requiereSesion: true },
	{ texto: 'Cómo funciona', href: '/#como-funciona', clase: 'hidden sm:block' },
];
---

<header
	class="sticky top-0 z-20 border-b border-neutral-200 bg-white/85 backdrop-blur dark:border-neutral-800 dark:bg-neutral-950/85"
>
	<div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4 sm:px-6 lg:px-8">
		<a
			href="/"
			class="rounded font-display text-xl font-semibold tracking-tight text-brand-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-600 dark:text-brand-100 dark:focus-visible:outline-accent-300"
		>
			ApunteUNLu<span class="text-accent-500" aria-hidden="true">.</span>
		</a>

		<nav aria-label="Principal">
			<ul class="flex items-center gap-6 text-sm font-medium">
				{
					enlaces.map((enlace) => (
						<li class={enlace.clase}>
							<a
								href={enlace.href}
								data-requiere-sesion={enlace.requiereSesion ? '' : undefined}
								class="rounded text-neutral-700 underline decoration-transparent underline-offset-4 transition hover:text-brand-700 hover:decoration-accent-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-600 dark:text-neutral-300 dark:hover:text-white dark:focus-visible:outline-accent-300"
							>
								{enlace.texto}
							</a>
						</li>
					))
				}
			</ul>
		</nav>

		<!-- Sólo lo ve un administrador: el script de abajo quita el atributo hidden si el rol lo corresponde -->
		<a
			id="enlace-panel"
			href="/panel"
			hidden
			class="group inline-flex items-center gap-2 rounded-full bg-brand-700 py-2 pr-4 pl-2 text-sm font-semibold text-white shadow-sm ring-1 ring-brand-800/20 transition hover:bg-brand-800 hover:shadow-md focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-600 dark:bg-brand-400 dark:text-brand-950 dark:ring-brand-300/30 dark:hover:bg-brand-300 dark:focus-visible:outline-brand-300"
		>
			<span
				class="grid size-7 place-items-center rounded-full bg-accent-400 text-brand-950 transition group-hover:scale-105"
				aria-hidden="true"
			>
				<svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round">
					<rect x="3" y="3" width="7.5" height="8.5" rx="1.75" />
					<rect x="13.5" y="3" width="7.5" height="4.5" rx="1.75" />
					<rect x="13.5" y="10.5" width="7.5" height="10.5" rx="1.75" />
					<rect x="3" y="14.5" width="7.5" height="6.5" rx="1.75" />
				</svg>
			</span>
			Panel
		</a>
	</div>
</header>

<script>
	import { obtenerRol } from '../lib/roles';

	const enlacePanel = document.getElementById('enlace-panel');
	if (enlacePanel) {
		obtenerRol().then((rol) => {
			if (rol === 'administrador') enlacePanel.hidden = false;
		});
	}
</script>
