<!-- Modal de ingreso por legajo: lo abre src/lib/sesion.ts antes de llevar a una sección protegida. -->
<dialog
	id="modal-sesion"
	aria-labelledby="titulo-sesion"
	class="m-auto w-[min(92vw,26rem)] rounded-2xl bg-white p-7 text-neutral-800 shadow-xl ring-1 ring-neutral-200 backdrop:bg-brand-950/60 dark:bg-neutral-900 dark:text-neutral-200 dark:ring-neutral-800"
>
	<form id="paso-legajo">
		<h2 id="titulo-sesion" class="font-display text-2xl font-semibold tracking-tight text-brand-950 dark:text-brand-50">
			Ingresá con tu legajo
		</h2>
		<p class="mt-3 leading-relaxed text-neutral-700 dark:text-neutral-300">
			Para ver y subir apuntes, parciales y finales, ingresá tu número de legajo de la Licenciatura en Sistemas. Sólo lo usamos para confirmar que figurás en el padrón.
		</p>
		<label for="legajo" class="mt-5 block text-sm font-medium text-neutral-800 dark:text-neutral-200">Número de legajo</label>
		<input
			id="legajo"
			name="legajo"
			type="text"
			inputmode="numeric"
			autocomplete="off"
			required
			class="mt-2 w-full rounded-md bg-white px-3 py-2.5 text-neutral-900 ring-1 ring-neutral-300 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-600 dark:bg-neutral-950 dark:text-neutral-100 dark:ring-neutral-700 dark:focus-visible:outline-brand-300"
		/>
		<p id="error-sesion" role="alert" class="mt-3 min-h-5 text-sm font-medium text-red-700 dark:text-red-300"></p>
		<div class="mt-6 flex flex-col-reverse gap-3 sm:flex-row sm:justify-end">
			<button
				type="button"
				data-cerrar-modal
				class="rounded-md px-5 py-3 font-medium text-neutral-700 transition hover:bg-neutral-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-600 dark:text-neutral-300 dark:hover:bg-neutral-800 dark:focus-visible:outline-brand-300"
			>
				Cancelar
			</button>
			<button
				type="submit"
				id="boton-legajo"
				class="rounded-md bg-brand-700 px-5 py-3 font-semibold text-white shadow-sm transition hover:bg-brand-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-600 disabled:opacity-60 dark:bg-brand-400 dark:text-brand-950 dark:hover:bg-brand-300 dark:focus-visible:outline-brand-300"
			>
				Verificar legajo
			</button>
		</div>
	</form>
</dialog>
